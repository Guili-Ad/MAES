        self.assertEqual(recover_masked_taps(e.tracks,f,e.calibration,lambda c:assign_lane(c,e.calibration)),{})

    def test_hold_bonus_and_executed_heads_are_not_recovered(self):
        for change in ('hold','bonus','sent'):
            e,t,c,f=self.scene()
            if change=='hold': t.gesture=NoteGesture.HOLD_START
            if change=='bonus': t.bonus_star=True
            if change=='sent': t.tap_input_started=.12
            self.assertEqual(recover_masked_taps(e.tracks,f,e.calibration,lambda c:assign_lane(c,e.calibration)),{})

    def test_two_initial_cap_samples_must_not_lock_a_noisy_velocity(self):
        cal=calibration()
        e=MusicVisionEngine(cal,MusicConfig(enable_holds=True))
        t=NoteTrack(1,2,gesture=NoteGesture.HOLD_START,state=TrackState.HOLDING,
                    predicted_hit_time=0.,hold_release_time=2.)
        e.tracks[1]=t
        # The second point follows three missed frames and a biased centroid.
        # Geometry relative to the test calibration, with exactly the recorded
        # displacements/time intervals, not a fixed chart action sequence.
        points=[(.254,(555.,172.)),(.515,(498.,206.5)),(.575,(495.,239.5)),
                (.644,(480.,257.5)),(.720,(457.5,281.5))]
        for seq,(stamp,center) in enumerate(points,1):
            progress,distance,_=project_to_polyline(center,cal.lane_centerlines[1])
            tail=HoldTailDetection(progress,.9,160,1,center,distance,1,'terminal',(2,))
            frame=MusicFrame(seq,stamp,stamp,stamp,np.zeros((720,1280,3),np.uint8))
            if seq==1: e._record_active_hold_tail(t,frame,tail)
            else:
                with patch('agent.music.tracking.detect_hold_tails',return_value=[tail]), patch('agent.music.tracking.hold_ribbon_present',return_value=False):
                    e._update_active_hold_tails(frame)
        self.assertEqual(t.hold_tail_observations[-1].center,points[-1][1])
        self.assertGreaterEqual(len(t.hold_tail_observations),4)

    def test_fresh_frame_service_must_not_sleep_on_future_ordinary_tap(self):
        config=MusicConfig()
        runtime=MusicRuntime(SimpleNamespace(),config,clock=lambda:1.)
        executor=MusicActionExecutor(SimpleNamespace(),1280,720,config,advanced=False)
        event=MusicActionEvent('ordinary',1,3,NoteGesture.TAP,1.08,(640,620))
        with patch.object(runtime,'sleeper',side_effect=AssertionError('fresh pixels must be processed first')):
            # Capability default lets the old implementation demonstrate the
            # defect by its actual sleep, rather than a missing-method error.
            kwargs={'fresh_frame':True} if 'fresh_frame' in runtime._execute_due.__code__.co_varnames else {}
            runtime._execute_due(executor,[event],1.,RuntimeMetrics(),**kwargs)

    def test_fresh_frame_executes_overdue_tap_without_postponement(self):
        config=MusicConfig()
        runtime=MusicRuntime(SimpleNamespace(),config,clock=lambda:1.)
        executor=MusicActionExecutor(SimpleNamespace(),1280,720,config,advanced=False)
        pending=[MusicActionEvent('ordinary',1,3,NoteGesture.TAP,.999,(640,620))]
        with patch.object(executor,'tap_many',return_value=[]) as send:
            runtime._execute_due(executor,pending,1.,RuntimeMetrics(),fresh_frame=True)
        send.assert_called_once()
        self.assertEqual(pending,[])

    def test_fresh_frame_keeps_existing_twenty_ms_freeze_precision(self):
        for deadline,frozen in [(1.015,False),(1.08,True)]:
            config=MusicConfig();time=[1.]
            def clock():
                time[0]+=.0001
                return time[0]
            runtime=MusicRuntime(SimpleNamespace(),config,clock=clock,sleeper=lambda dt:time.__setitem__(0,time[0]+dt))
            executor=MusicActionExecutor(SimpleNamespace(),1280,720,config,advanced=False)
            pending=[MusicActionEvent('frozen',1,3,NoteGesture.TAP,deadline,(640,620),tap_frozen=frozen)]
            with patch.object(executor,'tap_many',return_value=[]) as send:
                runtime._execute_due(executor,pending,time[0],RuntimeMetrics(),fresh_frame=True)
            send.assert_called_once()
            self.assertEqual(pending,[])
            self.assertLess(abs(time[0]-deadline),.001)

    def test_fresh_frame_hold_wait_and_due_tap_have_one_shared_removal_set(self):
        config=MusicConfig(enable_holds=True)
        time=[1.]
        def clock():
            time[0]+=.0001
            return time[0]
        runtime=MusicRuntime(SimpleNamespace(),config,clock=clock,sleeper=lambda dt:time.__setitem__(0,time[0]+dt))
        executor=MusicActionExecutor(SimpleNamespace(),1280,720,config,advanced=True)
        pending=[MusicActionEvent('hold',2,2,NoteGesture.HOLD_START,1.04,(430,620)),
                 MusicActionEvent('tap',1,3,NoteGesture.TAP,1.03,(640,620))]
        with patch.object(executor,'tap_many',return_value=[]) as send, patch.object(executor,'touch_down') as hold:
            runtime._execute_due(executor,pending,time[0],RuntimeMetrics(),fresh_frame=True)
        send.assert_called_once()
        hold.assert_called_once()
        self.assertEqual(pending,[])


