        f.image[(f.image[:,:,0]==255)]=(180,220,20)
        self.assertEqual(recover_masked_taps(e.tracks,f,e.calibration,lambda c:assign_lane(c,e.calibration)),{})

    def test_two_missing_owners_cannot_both_claim_one_visible_circle(self):
        e,t,c,f=self.scene()
        other=history([(0.,.44),(.05,.48),(.10,.52)],2)
        other.observations=type(other.observations)([
            replace(o,candidate=candidate_at(e.calibration,3,o.progress,56)) for o in other.observations],maxlen=12)
        e.tracks[2]=other
