{
    "Default": {
        "rate_limit": 500,
        "timeout": 180000,
        "pre_delay": 0,
        "post_delay": 0
    },
    "TemplateMatch": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "threshold": 0.7,
                "method": 5
            }
        }
    },
    "OCR": {
        "recognition": {
            "type": "OCR",
            "param": {
                "threshold": 0.3,
                "order_by": "Horizontal",
                "replace": []
            }
        }
    },
    "Click": {
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        }
    },
    "Swipe": {
        "action": {
            "type": "Swipe",
            "param": {
                "duration": 200
            }
        }
    }
}
